{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "governor/**/*.ts",
    "packages/sdk-js/**/*.ts",
    "packages/eslint-plugin-softstop/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/core",
    "packages/gateway",
    "packages/server",
    "packages/storage",
    "packages/cli"
  ]
}
