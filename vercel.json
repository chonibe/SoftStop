{
  "version": 2,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "demo",
  "framework": null,
  "rewrites": [
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/demo/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/install.sh",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    }
  ]
}
