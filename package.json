{
  "name": "softstop",
  "version": "0.2.1",
  "private": true,
  "description": "SoftStop — every AI agent should ask permission before interrupting a human. Shared user pressure across agents and systems.",
  "packageManager": "pnpm@8.15.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "GOVERNOR_STORAGE=memory tsx governor/api/src/server.ts",
    "start": "tsx governor/api/src/server.ts",
    "build": "turbo build",
    "test": "vitest run",
    "test:governor": "vitest run --config vitest.config.ts",
    "test:pg-stress": "SOFTSTOP_PG_STRESS=1 vitest run --config vitest.config.ts governor/tests/pg-concurrency.stress.test.ts",
    "test:pg-legacy": "node scripts/pg-legacy-migration-acceptance.mjs",
    "docker:smoke": "bash scripts/docker-smoke.sh",
    "bench:check": "tsx scripts/microbench-check.ts",
    "orphan-sweeper": "node scripts/orphan-sweeper.js",
    "typecheck": "tsc --noEmit",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "governor": "node scripts/governor-cli.js",
    "softstop": "node scripts/governor-cli.js",
    "docs:dev": "pnpm --filter @softstop/docs dev",
    "docs:build": "pnpm --filter @softstop/docs build",
    "docs:preview": "pnpm --filter @softstop/docs preview",
    "docs:smoke": "pnpm --filter @softstop/docs smoke"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.8",
    "@types/supertest": "^6.0.3",
    "supertest": "^6.3.4",
    "tsup": "^8.0.2",
    "tsx": "^4.16.2",
    "turbo": "^1.12.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chonibe/SoftStop.git"
  },
  "keywords": [
    "softstop",
    "governor",
    "escalation",
    "pressure",
    "frequency-cap",
    "cooldown",
    "check-record",
    "authorization",
    "user-pressure"
  ],
  "license": "MIT",
  "bin": {
    "governor": "./scripts/governor-cli.js",
    "softstop": "./scripts/governor-cli.js"
  }
}
