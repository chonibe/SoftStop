# Local SoftStop API (default when unset: http://localhost:3000)
# Prefer SoftStop naming; GOVERNOR_API_URL remains supported.
SOFTSTOP_API_URL=http://localhost:3000
GOVERNOR_API_URL=http://localhost:3000

# Optional: hosted evaluation endpoint (not required for self-host)
# SOFTSTOP_API_URL=https://governer.vercel.app
# GOVERNOR_API_URL=https://governer.vercel.app

# Server port
PORT=3000

# Optional: force in-memory even if Supabase vars exist (local/CI)
# GOVERNOR_STORAGE=memory

# Optional admin API for tenant-scoped keys
GOVERNOR_ADMIN_SECRET=
